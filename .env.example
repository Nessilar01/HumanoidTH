# Local Postgres (see README). Prisma Postgres also works:
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_POSTGRES_API_KEY"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hth"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Network graph source mode: auto, file, database, or hybrid.
NETWORK_GRAPH_SOURCE="auto"
NETWORK_GRAPH_IMPORT_FILE_PATH="data/imports/thailand_humanoid_atlas_seed_records.json"

# Signs session cookies (HMAC-SHA256). REQUIRED, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Admin login (/admin-login) and HTTP Basic for /api/ingest/* and /api/export.
# No defaults: leave empty and admin access stays disabled.
ADMIN_BASIC_USER=""
ADMIN_BASIC_PASSWORD=""

# Optional ingestion keys. Leave blank to use public/no-key endpoints where available.
YOUTUBE_API_KEY=""
GITHUB_TOKEN=""

# AI features (optional). gemini-1.5-flash may be retired; set a current model.
GEMINI_API_KEY=""
GEMINI_MODEL=""
